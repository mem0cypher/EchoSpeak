{
  "name": "Video Editor",
  "description": "Agentic Project-bound video editing: inspect structured editor context, plan with VideoSkills, propose timeline operations, submit durable jobs, and apply only after exact approval. Never rewrite timeline JSON or emit FFmpeg/shell commands.",
  "prompt_file": "SKILL.md",
  "version": "1.1.0",
  "origin": "built_in",
  "owner": "echospeak",
  "supported_modes": ["video", "chat"],
  "accepted_intents": [
    "video edit",
    "timeline",
    "rough cut",
    "captions",
    "remove silence",
    "b-roll",
    "highlights"
  ],
  "required_project_state": ["active_project"],
  "required_context_fields": [
    "document_id",
    "document_revision",
    "timeline",
    "authority"
  ],
  "tools": [
    "video_get_editor_context",
    "video_inspect_media",
    "video_inspect_timeline",
    "video_list_capabilities",
    "video_list_skills",
    "video_plan_request",
    "video_propose_operations",
    "video_apply_transaction",
    "video_submit_job",
    "video_get_job",
    "video_cancel_job",
    "video_retry_job",
    "video_update_creative_memory",
    "web_search"
  ],
  "required_tools": [
    "video_get_editor_context",
    "video_plan_request",
    "video_propose_operations",
    "video_apply_transaction"
  ],
  "optional_tools": [
    "video_submit_job",
    "video_get_job",
    "web_search"
  ],
  "required_capabilities": [
    "deterministic_editing",
    "agent_proposals",
    "approvals"
  ],
  "permissions": ["video_agent_edits", "system_actions"],
  "approval_policy": {
    "requires_approval": true,
    "stale_revision_invalidates": true
  },
  "verification_rules": [
    "revision_advanced",
    "toolrun_terminal_truth",
    "no_false_job_completion"
  ],
  "compatibility_version": "1",
  "implementation_entry": "package:video_editor"
}
